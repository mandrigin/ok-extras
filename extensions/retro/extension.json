{
  "id": "retro",
  "description": "Retro games",
  "apps": {
    "retro": {
      "desktop": "kids-retro.desktop",
      "icon": "retroarch",
      "label": "Retro games",
      "budget": "retro",
      "schedule": true,
      "argv": [
        "/usr/bin/retroarch",
