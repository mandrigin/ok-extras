#!/usr/bin/python3
import os
import pwd
import sys
from pathlib import Path

sys.path.insert(0, '/opt/omarchy-kids-policy')
from kids_policy.client import request
from kids_policy.migrate import default_config
from kids_policy.paths import CONFIG
from kids_policy.store import read_json

SAFE_ENV = (
    'PATH', 'HOME', 'USER', 'LOGNAME', 'LANG', 'LC_ALL', 'LANGUAGE',
    'DISPLAY', 'WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR', 'XDG_DATA_HOME',
    'XDG_CONFIG_HOME', 'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'XDG_CURRENT_DESKTOP',
    'XDG_SESSION_TYPE', 'DBUS_SESSION_BUS_ADDRESS', 'HYPRLAND_INSTANCE_SIGNATURE',
    'LIBGL_ALWAYS_SOFTWARE',
)


def main():
    if len(sys.argv) != 2:
        sys.stderr.write('Usage: omarchy-kids-launch <digger|micropolis|retro|minecraft|stardew_valley|vlc>\n')
        sys.exit(2)
    if os.geteuid() != 0:
        sys.stderr.write('launch helper must run as root via sudo\n')
        sys.exit(1)
    app = sys.argv[1]
    request({'op': 'may_launch', 'app': app})
    config = default_config()
    loaded = read_json(CONFIG, {}) or {}
    config.update({key: value for key, value in loaded.items() if key != 'apps'})
    if isinstance(loaded.get('apps'), dict):
        config['apps'].update(loaded['apps'])
    spec = config['apps'][app]
    argv = list(spec['argv'])
    if not Path(argv[0]).exists():
        raise SystemExit(f'{app} is not installed')
    uid = int(config['child_uid'])
    user = pwd.getpwuid(uid)
    pid = os.fork()
    if pid == 0:
        os.setsid()
        os.chdir(user.pw_dir)
        devnull = os.open('/dev/null', os.O_RDWR)
        os.dup2(devnull, 0)
        os.dup2(devnull, 1)
        os.dup2(devnull, 2)
        os.close(devnull)
        os.initgroups(user.pw_name, user.pw_gid)
        os.setgid(user.pw_gid)
        os.setuid(uid)
        env = {key: os.environ[key] for key in SAFE_ENV if key in os.environ}
        env.update({
            'HOME': user.pw_dir,
            'USER': user.pw_name,
            'LOGNAME': user.pw_name,
            'XDG_RUNTIME_DIR': os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{uid}'),
            'DBUS_SESSION_BUS_ADDRESS': os.environ.get(
                'DBUS_SESSION_BUS_ADDRESS', f'unix:path=/run/user/{uid}/bus'
            ),
            'PATH': '/usr/local/bin:/usr/bin',
        })
        os.execvpe(argv[0], argv, env)
    request({'op': 'adopt', 'app': app, 'pid': pid})


if __name__ == '__main__':
    try:
        main()
    except RuntimeError as exc:
        sys.stderr.write(f'{exc}\n')
        sys.exit(1)
