#!/usr/bin/python3
import pwd
import sys
from pathlib import Path

sys.path.insert(0, '/opt/omarchy-kids-policy')
from kids_policy.launcher import sync
from kids_policy.service import load_config


def main():
    config = load_config()
    uid = int(config.get('child_uid', 1000))
    home = Path(pwd.getpwuid(uid).pw_dir)
    account = pwd.getpwuid(uid)
    count = sync(home, config, account.pw_name, (uid, account.pw_gid))
    print(f'hidden {count} desktop entries')


if __name__ == '__main__':
    main()
