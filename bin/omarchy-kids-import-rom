#!/usr/bin/python3
import argparse
import sys
sys.path.insert(0, '/opt/omarchy-kids-policy')
from kids_policy.retro import GAMES, import_rom

parser = argparse.ArgumentParser(description='Import a parent-provided game ROM into the kids library')
parser.add_argument('game', choices=list(GAMES))
parser.add_argument('file')
args = parser.parse_args()
try:
    print(import_rom(args.game, args.file))
except (ValueError, OSError) as error:
    parser.exit(1, str(error) + '\n')
